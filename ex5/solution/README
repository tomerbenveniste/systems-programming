// To run test_input: 
//  ./executable1.exe <test_input.txt> teacher_output.txt
//  ./program.exe <test_input.txt> my_output.txt
//  diff -u my_output.txt teacher_output.txt
//  executable1.exe - the course's reference binary (not included in this repo;
//                    teacher_output.txt is its saved output)
//  program.exe - your compiled files (see CMakeLists.txt: the target is ex5_solution)
